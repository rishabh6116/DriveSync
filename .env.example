# --- Required ---
MONGODB_URI=
MONGODB_DB=drivesync
ADMIN_PASSCODE=
SESSION_SECRET=

# --- Google sign-in + Drive (see docs/GOOGLE_SETUP.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public URL of the site, e.g. https://your-app.vercel.app (auto-detected if empty)
# APP_URL=
# Optional: separate key for encrypting stored Google refresh tokens (falls back to SESSION_SECRET)
# TOKEN_ENC_KEY=

# --- Password reset email (SMTP). For Gmail use an App Password. ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
